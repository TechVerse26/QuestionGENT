{
  "name": "exam-master",
  "private": true,
  "version": "0.1.0",
  "description": "EXAM MASTER - question paper builder, question bank and examination management platform",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/core.test.mjs tests/export.test.mjs tests/ai.test.mjs",
    "deploy:firestore": "firebase deploy --only firestore:rules,firestore:indexes",
    "deploy:functions": "firebase deploy --only functions",
    "emulators": "firebase emulators:start",
    "check": "esbuild src/main.jsx --bundle --packages=external --format=esm --loader:.js=jsx --loader:.jsx=jsx --log-level=warning --outfile=node_modules/.cache/exam-master-check.js"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^3.9.0",
    "@tiptap/core": "^2.9.1",
    "@tiptap/extension-color": "^2.9.1",
    "@tiptap/extension-font-family": "^2.9.1",
    "@tiptap/extension-image": "^2.9.1",
    "@tiptap/extension-placeholder": "^2.9.1",
    "@tiptap/extension-subscript": "^2.9.1",
    "@tiptap/extension-superscript": "^2.9.1",
    "@tiptap/extension-table": "^2.9.1",
    "@tiptap/extension-table-cell": "^2.9.1",
    "@tiptap/extension-table-header": "^2.9.1",
    "@tiptap/extension-table-row": "^2.9.1",
    "@tiptap/extension-text-align": "^2.9.1",
    "@tiptap/extension-text-style": "^2.9.1",
    "@tiptap/extension-underline": "^2.9.1",
    "@tiptap/pm": "^2.9.1",
    "@tiptap/react": "^2.9.1",
    "@tiptap/starter-kit": "^2.9.1",
    "docx": "^9.5.0",
    "firebase": "^10.14.1",
    "jszip": "^3.10.1",
    "katex": "^0.16.11",
    "lucide-react": ">=0.400.0 <0.500.0",
    "mammoth": "^1.8.0",
    "papaparse": "^5.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-router-dom": "^6.27.0",
    "recharts": "^2.13.0",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "vite": "^5.4.10"
  }
}

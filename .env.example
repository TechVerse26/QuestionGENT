# Firebase web app config (Firebase console -> Project settings -> Your apps -> Web app).
# These values are public identifiers, not secrets. Real secrets go to Firebase Functions secrets (see README).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# AI question generator mode.
#   direct    (default) the browser calls Google Gemini with the user's own free key. No card, no Cloud Functions. See README 3c.
#   functions the original Cloud Function (needs the Firebase Blaze plan, i.e. a payment card).
# Never put a Gemini key in this file: everything here is compiled into the public site.
VITE_AI_MODE=direct

# Region where Cloud Functions are deployed (default us-central1)
VITE_FUNCTIONS_REGION=us-central1

# Cloudinary unsigned upload (optional - without it images can still be inserted by URL)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Set to true to talk to the local Firebase emulators (npm run emulators)
VITE_USE_EMULATORS=false
